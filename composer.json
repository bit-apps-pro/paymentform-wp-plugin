{
    "name": "paymentform/wp-plugin",
    "description": "PaymentForm WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "bitapps/wp-kit": "^2.5",
        "typisttech/imposter-plugin": "^0.6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "autoload": {
        "psr-4": {
            "PaymentForm\\": "backend/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PaymentForm\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/bootstrap.php"
        ]
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress backend/",
        "test": "phpunit",
        "package": "bin/package.sh"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "typisttech/imposter-plugin": true
        }
    },
    "extra": {
        "imposter": {
            "namespace": "PaymentForm\\Deps\\"
        }
    }
}
