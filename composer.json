{
    "name": "paymentform/wp-plugin",
    "description": "PaymentForm WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "bitapps/wp-kit": "*",
        "typisttech/imposter-plugin": "^0.6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "PaymentForm\\": "backend/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PaymentForm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress backend/",
        "test": "phpunit",
        "package": "bin/package.sh"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "typisttech/imposter-plugin": true
        }
    },
    "extra": {
        "imposter": {
            "namespace": "PaymentForm\\Deps\\"
        }
    }
}
