# Vite dev-server overrides (APP_ prefix exposed via import.meta.env).
# Used ONLY in dev (import.meta.env.DEV); production reads window.paymentformAdmin
# injected by PHP (backend/app/Config.php constants).
# APP_API_BASE_URL has no frontend consumer yet (REST goes through restUrl+nonce);
# declared for parity with the PHP Config constants / future use.
APP_API_BASE_URL=http://api.paymentform.btcd-test.io:8021
APP_APP_BASE_URL=http://app.paymentform.btcd-test.io:8021
APP_RENDERER_BASE_URL=
