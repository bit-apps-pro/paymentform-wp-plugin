# Dev-only overrides for the upstream hosts, read in development only:
#   - PHP: backend/app/Config.php reads this file directly
#     (Config::apiBaseUrl / appBaseUrl) for server-side upstream calls.
#   - Frontend: Vite exposes APP_* via import.meta.env (src/lib/devEnv.ts).
# Production never ships frontend/ (see bin/package.sh), so these are absent and
# Config falls back to its DEFAULT_* constants.
# The renderer host is derived from the app host per-tenant on the server side
# (Config::swapAppSubdomain), so it needs no override here.
APP_API_BASE_URL=http://api.paymentform.btcd-test.io:8021
APP_APP_BASE_URL=http://app.paymentform.btcd-test.io:8021
