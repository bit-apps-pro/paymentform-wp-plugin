<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" bootstrap="tests/bootstrap.php" colors="true" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="unit">
      <directory>tests/Unit</directory>
    </testsuite>
  </testsuites>
  <!--
    Restrict deprecation reporting to first-party code. wp-validator's
    InputDataContainer triggers a PHP "null array offset" deprecation on every
    Validator::make() call (vendor defect on PHP 8.1+); scoping the source to
    backend/ keeps our own deprecations strict without counting vendor ones.
  -->
  <source ignoreIndirectDeprecations="true">
    <include>
      <directory suffix=".php">backend</directory>
    </include>
  </source>
</phpunit>
